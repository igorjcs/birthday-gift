# Birthday Gift Configuration
# Copy this file to .env.local and customize the values

# Target date for the countdown (ISO 8601 format with timezone)
# Example: 2025-03-25T00:00:00-03:00
VITE_TARGET_DATE=2025-03-25T00:00:00-03:00

# YouTube video ID for the birthday surprise
# Example: aXr9iGm7BHo (from https://www.youtube.com/watch?v=aXr9iGm7BHo)
VITE_VIDEO_ID=aXr9iGm7BHo
